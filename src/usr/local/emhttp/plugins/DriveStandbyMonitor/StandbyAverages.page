<?
#Pull some default data
libxml_use_internal_errors(true); # Suppress any warnings from xml errors.

$scriptName = "DriveStandbyMonitor";
$docroot = $docroot ?? $_SERVER['DOCUMENT_ROOT'] ?: '/usr/local/emhttp';
$pluginRoot = "$docroot/plugins/$scriptName";
include_once( "./plugins/$scriptName/includes/page.php" );

$DSM = new DisksInfo( $disks );
$DB = new DSMDB( $DB_FILE );

$allowedWindows = array(1,3,7,14,30,90,365);
$days = intval($defaults["AVG_WINDOW_DAYS"] ?? 30);
if (!in_array($days, $allowedWindows)) $days = 30;

// Drives to show on Main (comma-separated serials in settings.cfg).
// If empty => show all.
$MAIN_VISIBLE_DRIVES = array();
$mainVisibleRaw = $defaults["MAIN_VISIBLE_DRIVES"] ?? "";
if ($mainVisibleRaw !== "") {
    foreach (explode(',', $mainVisibleRaw) as $d) {
        $d = trim($d);
        if ($d !== "") $MAIN_VISIBLE_DRIVES[] = $d;
    }
}

# Temporary storage for $disk array that is being manipulated
$DRIVE_STATUS = array();

// NOTE: This page shows the icon tiles on /Tools/DriveStandbyMonitor.
// It supports a ?days= query param to change the averaging window.
// Standby % is still based on log-entry counts, but we limit to the last N days.
$LIVE_COUNTS = array();
$STANDBY_COUNTS = array();

// Pull raw data and count entries within the selected window
$cutoff = time() - ($days * 86400);
while ( $row = $DB->getRawData() ){
    if ( intval($row['date']) < $cutoff ) continue;

    $drive = $row['drive'];
    $state = intval($row['state']);
    if ( $state === 0 ) {
        if (!isset($STANDBY_COUNTS[$drive])) $STANDBY_COUNTS[$drive] = 0;
        $STANDBY_COUNTS[$drive] += 1;
    } else {
        if (!isset($LIVE_COUNTS[$drive])) $LIVE_COUNTS[$drive] = 0;
        $LIVE_COUNTS[$drive] += 1;
    }
}

foreach ( $STANDBY_COUNTS as $drive => $cnt ){
    $DRIVE_STATUS[$drive]['standby'] = $cnt;
}
foreach ( $LIVE_COUNTS as $drive => $cnt ){
    $DRIVE_STATUS[$drive]['live'] = $cnt;
}

if( count($DRIVE_STATUS) !== 0 ) {

    # Calculate AVG & Set Name
    foreach ( $DRIVE_STATUS as $key => $val){
        $live = isset( $val['live'] ) ? $val['live'] : 0;
        $standby = isset( $val['standby'] ) ? $val['standby'] : 0;

        $DRIVE_STATUS[$key]['name'] = $DSM->getDeviceName( $key );
        $DRIVE_STATUS[$key]['device'] = $DSM->getDevice( $key );
        $DRIVE_STATUS[$key]['type'] = $DSM->getDeviceType( $key );

        if ( empty($DRIVE_STATUS[$key]['device']) ) {
            unset($DRIVE_STATUS[$key]);
            continue;
        }

        if ($standby < 1) {
            $DRIVE_STATUS[$key]['avg'] = 0;
        }else{
            $DRIVE_STATUS[$key]['avg'] = round( ( 100 * ( $standby / ($live + $standby) ) ), 2 );
        }
    }

    # Sort the list
    DSMTools::diskSort($DRIVE_STATUS);

}
?>
