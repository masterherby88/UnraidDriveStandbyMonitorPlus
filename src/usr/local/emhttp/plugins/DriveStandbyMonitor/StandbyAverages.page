                    <div>
                        <label>
                            <input type="checkbox" class="DSM-main-drive" value="<?=$id?>" <? if($checked) print('checked'); ?> />
                            <?=$disk['name']?>
                        </label>
                    </div>
                <? } ?>
            </div>
            <input type="button" id="DSM-save-main" value="Save Main Selection" style="margin-top:6px;" />
        </div>
        <?if( count($DRIVE_STATUS) === 0 ) {?>
        No data has been collected yet.
        Please wait up to 20 minutes for an update to occur.
        <?}else{?>
            <? foreach ( $DRIVE_STATUS as $key => $val) { ?>
            <div class="DSM-drive" title="This drive has been asleep for <? print($val['avg']); ?>% of the monitored time.">
                <div class="header">
                    <div class="image">
                        <i class="fa fa-hdd-o big white-text"></i>
                    </div>
                </div>
                <div class="body">
                    <div class="name">
                        <?=$val['name']; ?>
                    </div>
                    <div class="data">
                        <? print($val['avg']); ?>%
                    </div>
                </div>
            </div>
            <? } ?>
        <? } ?>
    </div>
    <div class="DSM-container">
        <div class="DSM-reset-db">
            <input type="button" id="DSM-reset-db" value="Reset DB" />
        </div>
    </div>
</div>
<script type="text/javascript">

async function resetDB(){
    const response = await fetch("/plugins/<?=$scriptName?>/reset_db.php", { "reset" : 1 } );
    const json = await response.json();
    window.location.reload(true);
    // Do some error checking later
}

document.addEventListener( 'DOMContentLoaded', () => {
    // Save average window days into /boot/config via a small PHP endpoint
    document.querySelector("#DSM-save-days").addEventListener("click", async () => {
        const days = document.querySelector("#DSM-days").value;
        const response = await fetch("/plugins/<?=$scriptName?>/set_avg_window.php?days=" + encodeURIComponent(days));
        try { await response.json(); } catch(e) {}
        window.location.reload(true);
    });

    document.querySelector("#DSM-save-main").addEventListener("click", async () => {
        const checked = Array.from(document.querySelectorAll('.DSM-main-drive:checked')).map(x => x.value);
        const url = "/plugins/<?=$scriptName?>/set_main_drives.php?drives=" + encodeURIComponent(checked.join(','));
        const response = await fetch(url);
        try { await response.json(); } catch(e) {}
        window.location.reload(true);
    });

    document.querySelector("#DSM-reset-db").addEventListener("click", () => {
        
        const confirmation = confirm("Are you sure you want to delete all previously logged data?\nThis cannot be undone.");
        
        if ( confirmation ) {
            resetDB();
        }
        
    });
});

</script>